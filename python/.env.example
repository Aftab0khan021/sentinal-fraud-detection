# SentinAL Backend — Environment Variables
# =========================================
# Copy this file to .env in the python/ directory:
#   cp .env.example .env
#
# Then fill in the required values below.

# -------------------------------------------------------
# REQUIRED — Generate secure values before first run:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# -------------------------------------------------------

# JWT Configuration
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_use_secrets_token_urlsafe_32
JWT_REFRESH_SECRET_KEY=CHANGE_THIS_REFRESH_KEY_IN_PRODUCTION_use_secrets_token_urlsafe_32
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# User password hashes (bcrypt)
# Generate with: python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('yourpassword'))"
DEMO_USER_HASH=$2b$12$CHANGE_THIS_TO_BCRYPT_HASH_OF_DEMO_PASSWORD
ADMIN_USER_HASH=$2b$12$CHANGE_THIS_TO_BCRYPT_HASH_OF_ADMIN_PASSWORD

# -------------------------------------------------------
# OPTIONAL — Reasonable defaults for local development
# -------------------------------------------------------

# Redis Configuration (set REDIS_ENABLED=false to use in-memory cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=sentinal_redis_2024_CHANGE_IN_PRODUCTION
REDIS_DB=0
REDIS_ENABLED=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
ENVIRONMENT=development

# Ollama Configuration (optional — AI explanations degrade gracefully without it)
OLLAMA_MODEL=llama3.2:1b

# Tracing (optional — disabled by default)
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Graph data integrity check (optional)
# Set to SHA-256 of graph_enhanced.pkl to enable tamper detection
# PKL_SHA256=

# Grafana Configuration (for Docker Compose deployments)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=SentinAL_Grafana_2024_CHANGE_IN_PRODUCTION
