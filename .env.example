# SentinAL Frontend — Environment Variables
# Copy this file to .env and fill in your values

# Bug #26: This variable is required for the frontend to connect to the backend.
# The api.ts service reads this value via import.meta.env.VITE_API_URL
# Without it, the app falls back to http://localhost:8000 (development only).

# Local development
VITE_API_URL=http://localhost:8000

# Production example (replace with your actual deployed API URL)
# VITE_API_URL=https://api.yourdomain.com
